-- ==========================================================
-- 5. ระบบทำงาน Auto Lift (ยกของ/ฟาร์มกล่อง)
-- ==========================================================
task.spawn(function()
    while task.wait(0.15) do
        if AutoLiftEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end

                -- ตรวจหาจุดกด ProximityPrompt เพื่อรับ/วางของ
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        local parentPart = prompt.Parent
                        if parentPart and parentPart:IsA("BasePart") then
                            local dist = (char.HumanoidRootPart.Position - parentPart.Position).Magnitude
                            if dist < 25 then
                                fireproximityprompt(prompt)
                                showNotify("ตรวจพบการเทเลพอร์ต")
                                task.wait(0.05)
                            end
                        end
                    end
                end

                -- ถือ/วาง Tool กล่องโดยอัตโนมัติ
                for _, item in ipairs(char:GetChildren()) do
                    if item:IsA("Tool") then
                        item:Activate()
                    end
                end
            end)
        end
    end
end)

